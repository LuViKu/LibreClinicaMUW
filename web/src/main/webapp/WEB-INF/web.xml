<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  2026-06-19 — bumped web-app schema from 2.4 (2003) to 6.0 (Jakarta
  EE 10 / Servlet 6). The 2.4 schema doesn't define the
  <async-supported> element introduced in Servlet 3.0, so the SSE
  endpoints (e.g. /pages/api/v1/retinal-jobs/{id}/status/stream) threw
  "Async support must be enabled on a servlet and for all filters
  involved in async request processing" — the SPA's EventSource
  auto-retried at ~1 Hz and the libreclinica log filled with stack
  traces. Tomcat 10 + Servlet 6 are the runtime baseline (Phase B
  cliff), so the schema bump is non-invasive: existing 2.4 elements
  remain forward-compatible under 6.0.
-->
<web-app version="6.0"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <display-name>LibreClinica</display-name>
    <description>LibreClinica Web Interface</description>

    <!--
        Phase C.14 cliff (2026-05-30): contextConfigLocation, all listeners,
        and all filters migrated out of web.xml. Boot's
        SpringBootServletInitializer owns root-context bootstrap;
        ServletInfraConfig owns surviving listeners + non-security filters;
        SecurityConfig owns the SecurityFilterChain @Bean. The 222 servlet
        declarations stay here for now — Boot does NOT auto-register Servlet
        beans, so they don't collide. Bulk servlet migration to
        LegacyServletRegistry @Configuration is a post-cliff cleanup pass
        (see phase-c14-web-xml-inventory.md).
    -->

    <context-param>
        <param-name>jmesaMessagesLocation</param-name>
        <param-value>at/ac/meduniwien/ophthalmology/libreclinica/jmesaResourceBundle</param-value>
    </context-param>

    <context-param>
        <param-name>SQLInitServlet</param-name>
        <param-value>org/</param-value>
    </context-param>


    <servlet>
        <servlet-name>pages</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
        <!--
          2026-06-19 — opt this DispatcherServlet into async support so
          SSE / DeferredResult / SseEmitter endpoints (notably
          /pages/api/v1/retinal-jobs/{id}/status/stream that the SPA
          opens for live status updates) work without
          IllegalStateException. web.xml-defined servlets default to
          async-unsupported regardless of Boot's auto-config; the flag
          must be explicit at the registration site. Needs the
          web-app 3.0+ schema (we run 6.0 since the bump above).
        -->
        <async-supported>true</async-supported>
        <!--
          Phase E.6 (2026-06-06): enable Servlet 6 multipart parsing on the
          pages DispatcherServlet. WebMvcConfig registers a
          StandardServletMultipartResolver which delegates to the
          container's multipart machinery — without this entry the
          Tomcat connector ignores multipart bodies and @RequestPart
          arrives as null on the CRF file-upload endpoint.

          Caps are intentionally generous (200 MiB request/file, 0 KB
          threshold so everything streams to a temp file): per-item
          enforcement lives in CrfFileStorageService.checkSize() so
          we can return 413 with a structured error code instead of
          letting Tomcat reject the request with a bare 500.
        -->
        <multipart-config>
            <max-file-size>209715200</max-file-size>
            <max-request-size>209715200</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>pages</servlet-name>
        <url-pattern>/pages/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>pages</servlet-name>
        <url-pattern>/oauth/*</url-pattern>
    </servlet-mapping>

    <!-- Phase C.16 (2026-05-30): 221 legacy servlet declarations migrated to
         config.LegacyServletRegistry (Boot @Configuration). Only the `pages`
         DispatcherServlet stays here because it loads its child context via
         the default `/WEB-INF/pages-servlet.xml` lookup path (which now
         contains a stub `<bean class="WebMvcConfig"/>`). The `ws` Spring-WS
         MessageDispatcherServlet + 2 Jersey servlets dropped here are the
         zombies inventoried in phase-c14-web-xml-inventory.md — Tomcat
         marked them unavailable on every deploy via
         java.lang.ClassNotFoundException: javax.servlet.Filter against
         the spring-ws / com.sun.jersey jars that never made the jakarta
         transition. -->

    <!-- Phase A2 (2026-06-10): global error-page dispatcher.
         Closes the legacy-servlet bypass — exceptions raised by the
         ~222 legacy servlets registered via LegacyServletRegistry
         today fall through to Tomcat's default HTML 500 page, which
         (a) bypasses the §11.10(e) failure audit trail and (b)
         returns HTML to /pages/api/v1/** JSON callers when the
         ApiExceptionHandler didn't catch first.

         GlobalErrorServlet is a raw HttpServlet (declared here, NOT in
         LegacyServletRegistry) so it stays addressable even if a
         future cleanup pass empties the @Configuration registry.
         It calls A1's FailureAuditTemplate equivalent
         (AuditEventDAO.insertOperationFailure) directly and content-
         negotiates: JSON request → {message, reqId} body, HTML
         request → forward to /WEB-INF/jsp/error-page.jsp (a self-
         contained minimal German page; the legacy /WEB-INF/jsp/error.jsp
         keeps its sidebar / bundle / session wiring for the few
         legacy paths that already target it). -->
    <servlet>
        <servlet-name>GlobalErrorServlet</servlet-name>
        <servlet-class>at.ac.meduniwien.ophthalmology.libreclinica.servlet.GlobalErrorServlet</servlet-class>
        <!-- 2026-06-19 — error dispatches from the async-supported
             pages DispatcherServlet (above) re-enter through this
             servlet; mark it async-supported too so the dispatch chain
             stays unbroken when a controller throws mid-emitter. -->
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping>
        <servlet-name>GlobalErrorServlet</servlet-name>
        <url-pattern>/error</url-pattern>
    </servlet-mapping>

    <error-page>
        <error-code>500</error-code>
        <location>/error</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error</location>
    </error-page>

</web-app>
