# ignore everything
*

# include config files
!/docker/config

# include maven file
!/pom.xml

# include modules
!/core
!/docs
!/odm
!/web
!/ws

# DR-024 — the retinal-inference Docker build now uses the repo root as
# its context so it can COPY both retinal-inference/ and the sibling
# muw-e2e-converter/ converter package into the image. Allow both
# directories through.
!/retinal-inference
!/muw-e2e-converter

# ignore build files
/*/target

# ignore SPA dependency artifacts — host pnpm install pulls in
# platform-specific native binaries (rollup, esbuild) that mismatch
# the linux/arm64 builder image. Let the container's `pnpm install`
# step inside the Docker build resolve them fresh for the right OS.
/web/src/spa/node_modules
/web/src/spa/dist
