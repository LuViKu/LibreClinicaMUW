# Apptainer image for the BMEIS (sese_pr) model on the GPU cluster.
#
# sese_pr is PyTorch 1.0; production ran it under CUDA 10.1 (the wrapper's LMOD
# modules), so we base on a torch-1.0.1 / CUDA-10 image — which DOES have Turing
# (sm_75) kernels, so this runs on the RTX 2080 Ti as well as the TITAN Xp/V.
# (A CUDA-9 base is the thing that can't target Turing — avoid it.)
#
# This image carries only the *environment*; the vendor code + weights are
# bind-mounted at runtime by the ApptainerAdapter (s.bmeis_code / s.bmeis_weights),
# so nothing licensed is baked into the .sif.
#
# Build on the cluster:
#   apptainer build --fakeroot bmeis.sif retinal-inference/runners/bmeis/apptainer.def
# Then point RETINAL_INFERENCE_BMEIS_SIF at the result, and
#   RETINAL_INFERENCE_BMEIS_CODE  -> a checkout of sese_pr/code/photoreceptors-segmentation
#   RETINAL_INFERENCE_BMEIS_WEIGHTS -> .../weights/u2net-cross-entropy   (Spectralis model)
#
# Confirm on the cluster:
#   * the full-pickle model.pkl loads under this torch build (1.0.x ABI);
#   * the forced .cuda() in segmentation/model_factory.py is fine on GPU (it is
#     here, since we run with --nv); for CPU-only nodes patch it.

Bootstrap: docker
From: pytorch/pytorch:1.0.1-cuda10.0-cudnn7-runtime

%post
    # sese_pr's runtime deps. NB: no imutils/opencv — the only cv2 reference in the
    # vendor code is a commented-out import, and nothing imports imutils. Adding
    # imutils would drag in cv2 (and libGL) and fail at import for nothing.
    pip install --no-cache-dir "numpy" "scipy" "scikit-image" "SimpleITK==1.2.4"

%runscript
    exec "$@"
