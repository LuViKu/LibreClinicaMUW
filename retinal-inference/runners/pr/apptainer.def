# Apptainer image for the PR (photoreceptor, sese_pr) model on the GPU cluster.
#
# sese_pr is PyTorch 1.0; production ran it under CUDA 10.1 (the wrapper's LMOD
# modules), so we base on a torch-1.0.1 / CUDA-10 image — which DOES have Turing
# (sm_75) kernels, so this runs on the RTX 2080 Ti as well as the TITAN Xp/V.
# (A CUDA-9 base is the thing that can't target Turing — avoid it.)
#
# This image carries only the *environment*; the vendor code + weights are
# bind-mounted at runtime by the ApptainerAdapter (s.pr_code / s.pr_weights),
# so nothing licensed is baked into the .sif.
#
# Build on the cluster:
#   apptainer build --fakeroot pr.sif retinal-inference/runners/pr/apptainer.def
# Then point RETINAL_INFERENCE_PR_SIF at the result, and
#   RETINAL_INFERENCE_PR_CODE  -> a checkout of sese_pr/code/photoreceptors-segmentation
#   RETINAL_INFERENCE_PR_WEIGHTS -> .../weights/u2net-cross-entropy   (Spectralis model)
#
# Confirm on the cluster:
#   * the full-pickle model.pkl loads under this torch build (1.0.x ABI);
#   * the forced .cuda() in segmentation/model_factory.py is fine on GPU (it is
#     here, since we run with --nv); for CPU-only nodes patch it.

Bootstrap: docker
From: pytorch/pytorch:1.0.1-cuda10.0-cudnn7-runtime

%post
    # sese_pr's runtime deps (full import chain of process_input_for_optimus.py ->
    # compute_scores -> util.metrics: numpy, scipy, scikit-image, SimpleITK,
    # scikit-learn; matplotlib comes from the base image). scikit-learn 0.24.2 is
    # the last release supporting the base image's Python 3.6. NB: no imutils/opencv
    # — the only cv2 reference in the vendor code is a commented-out import.
    pip install --no-cache-dir "numpy" "scipy" "scikit-image" "SimpleITK==1.2.4" "scikit-learn==0.24.2"

%runscript
    exec "$@"
