<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        nAMD treat-and-extend Slice 3 (2026-06-20) — AI-fluid items
        on the NAMD_VISIT CRF.

        Adds a fifth section to NAMD_VISIT (Slice 2 / PR #227) with
        per-eye numeric items for the AI fluid quantification. These
        items are designed to be AUTO-POPULATED by the new
        `RetinalResultItemDataPopulator` service from the linked
        `retinal_inference_result.output_payload` JSONB — physicians
        don't type these numbers in.

        ID allocation continuing from Slice 2:
          - section_id            = 11  (Slice 2 used 7..10)
          - item_id               = 52..59
          - item_form_metadata_id = 29..36

        Naming convention matches the laterality-prefixed pattern
        already established for OPHTH_VISIT (e.g. VA_OD_LOGMAR):
        `NAMD_<EYE>_<METRIC>_MM3` so the populator + SAS exports can
        pattern-match per-eye columns. Re-uses the existing
        `freetext_namd` response set (rs_id=14) since these are
        REAL items typed via the freetext gate.
    -->

    <changeSet author="muw-ophthalmology" id="2026-06-20-namd-visit-ai-items" context="demo">
        <comment>NAMD_VISIT AI fluid section — 1 section + 8 items + 8 item_form_metadata.</comment>

        <!-- ============================================================
             Section 5 — AI fluid quantification
             ============================================================ -->
        <insert tableName="section">
            <column name="section_id" valueNumeric="11"/>
            <column name="crf_version_id" valueNumeric="21"/>
            <column name="status_id" valueNumeric="1"/>
            <column name="label" value="S_NAMD_AI_FLUID"/>
            <column name="title" value="AI fluid quantification (auto-populated)"/>
            <column name="instructions" value="Per-eye fluid volumes from the AI segmentation of today's OCT. Auto-populated from the linked retinal_inference_result when a fluid job completes; physicians may override but the audit trail records the source job. Blank entries mean no scan was uploaded for that eye at this visit. Arm B subjects: these items remain hidden in the UI but are still populated server-side for analysis."/>
            <column name="ordinal" valueNumeric="5"/>
            <column name="date_created" valueDate="2026-06-20"/>
            <column name="owner_id" valueNumeric="1"/>
        </insert>

        <!-- ============================================================
             Items — 8 (OD + OS × IRF/SRF/PED/TOTAL)
             ============================================================ -->
        <insert tableName="item">
            <column name="item_id" valueNumeric="52"/>
