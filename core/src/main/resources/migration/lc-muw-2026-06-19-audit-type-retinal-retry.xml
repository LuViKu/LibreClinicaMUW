<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        Retinal retry endpoint (2026-06-19): seed audit type 118 so the
        new POST /retinal-jobs/{jobId}/retry endpoint can record operator
        re-dispatches of `failed` jobs without re-uploading the .e2e.

        118 — retinal_job_retry | retinal_inference_job

        See AuditTypeIds.java for the constant.
    -->
    <changeSet id="2026-06-19-audit-type-retinal-retry"
               author="muw-ophthalmology"
               dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM audit_log_event_type
                WHERE audit_log_event_type_id = 118;
            </sqlCheck>
        </preConditions>
        <comment>
            Seed the retinal-retry audit type. Surfaces in per-study
            audit views (is_user_visible=true) so the operator timeline
            shows manual re-dispatches alongside the original uploads.
        </comment>

        <insert tableName="audit_log_event_type">
            <column name="audit_log_event_type_id" valueNumeric="118"/>
            <column name="name" value="retinal_job_retry"/>
            <column name="display_name" value="Retinal job retried (manual re-dispatch)"/>
            <column name="is_user_visible" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="audit_log_event_type">
                <where>audit_log_event_type_id = 118</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
