    <!--
        Phase E.X (2026-06-19): demo seed for the public OCT-upload
        portal's state-machine smoke tests.

        Adds three studies + three subjects + nine scheduled events so
        the operator can drop the 12 sample `.e2e` files at
        /Volumes/NO NAME/e2e_test/ (six dates spanning 2023-05 to
        2025-11) and exercise every /resolve outcome:

          - "suggested" — drop a file whose date matches one of the
            six scheduled events for EIAMD139 in the RIS study
          - "novisit"  — drop a file at a date not matching any event
            (e.g. the 2026-01-01 placeholder is intentionally left
            without a matching file)
          - "nopatient"— drop a file whose label is unknown (any
            label not in {EIAMD138, EIAMD139, EIAMD140})
          - cross-study patient search — typing "EIAMD13" returns
            EIAMD139 + EIAMD140 from two active studies (EIAMD138
            stays hidden because its study is archived)

        High-numbered ids (100+) keep this fixture out of the way of
        the existing M-001..M-007 demo seed (subjects 1-7,
        study_subjects 1-7, study_events 1-21, event_crfs 1-16) and
        any future bumps to that fixture. A trailing sequence-bump
        changeset advances every affected sequence past the seeded
        max so subsequent runtime inserts don't collide.

        Both changesets carry `context="demo"` — they're skipped when
        LIQUIBASE_CONTEXTS is unset (production deployments) per the
        compose.yaml comment at line 39.
    -->
    <changeSet author="muw-ophthalmology" id="2026-06-19-seed-oct-portal-fixture-tables"
               context="demo">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM study WHERE study_id = 102;
            </sqlCheck>
        </preConditions>
        <comment>
            Three studies (RIS active, AMD active, Archived frozen) +
            three subjects (EIAMD139, EIAMD140, EIAMD138) + event
            definitions + 9 scheduled events with their event_crf rows.
        </comment>

