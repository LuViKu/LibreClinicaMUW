    <!-- ============================================================
         Sequence bump. PostgreSQL SERIAL columns each own a sequence
         named `<table>_<col>_seq`; advance every one past our high
         seeded ids so subsequent runtime inserts don't collide.
         setval(currval=N) means the next nextval() returns N+1.
         ============================================================ -->
    <changeSet author="muw-ophthalmology" id="2026-06-19-seed-oct-portal-fixture-bump-sequences"
               context="demo" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="t">
                SELECT EXISTS (SELECT 1 FROM study WHERE study_id = 102);
            </sqlCheck>
        </preConditions>
        <comment>
            Advance every affected SERIAL sequence past the seeded max
            so runtime INSERTs don't collide with our high fixture ids.
        </comment>
        <sql splitStatements="false"><![CDATA[
            SELECT setval('study_study_id_seq',                                     GREATEST((SELECT MAX(study_id)                       FROM study),                       1));
            SELECT setval('subject_subject_id_seq',                                 GREATEST((SELECT MAX(subject_id)                     FROM subject),                     1));
            SELECT setval('study_subject_study_subject_id_seq',                     GREATEST((SELECT MAX(study_subject_id)               FROM study_subject),               1));
            SELECT setval('study_event_definition_study_event_definition_id_seq',   GREATEST((SELECT MAX(study_event_definition_id)      FROM study_event_definition),      1));
            SELECT setval('event_definition_crf_event_definition_crf_id_seq',       GREATEST((SELECT MAX(event_definition_crf_id)        FROM event_definition_crf),        1));
            SELECT setval('study_event_study_event_id_seq',                         GREATEST((SELECT MAX(study_event_id)                 FROM study_event),                 1));
            SELECT setval('event_crf_event_crf_id_seq',                             GREATEST((SELECT MAX(event_crf_id)                   FROM event_crf),                   1));
        ]]></sql>
    </changeSet>

