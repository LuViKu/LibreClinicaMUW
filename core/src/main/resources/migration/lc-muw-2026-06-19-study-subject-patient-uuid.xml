<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        Wave 1B (2026-06-19): cross-study patient identity soft-link.

        Adds a nullable patient_uuid VARCHAR(36) column to study_subject.
        Set when the nurse links a new enrolment to an existing patient
        match via POST /api/v1/study-subjects/{id}/link-patient (see
        SubjectsApiController.linkPatient). Null when the subject is a
        new patient that has never been linked.

        VARCHAR(36) over native postgres UUID because the rest of the
        schema uses VARCHAR for cross-DB portable UUID storage (mirrors
        oc_oid, person_id, etc.).

        Plan: /Users/lukas/.claude/plans/robust-jumping-eich.md
        (Wave 1B · Patient identity across studies).

        Also seeds audit type 119 (STUDY_SUBJECT_PATIENT_LINKED) so the
        new link endpoint can write an audit_log_event row each time a
        nurse cross-links two study_subject rows under the same UUID.
        Type 118 was claimed by lc-muw-2026-06-19-audit-type-retinal-retry
        for RETINAL_JOB_RETRY; we extend with 119.
    -->
    <changeSet id="2026-06-19-study-subject-patient-uuid-column"
               author="muw-ophthalmology"
               dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="study_subject" columnName="patient_uuid"/>
            </not>
        </preConditions>
        <comment>
            Soft-link across studies. Set when the nurse links a new
            enrolment to an existing patient match. Null when the subject
            is a new patient.
        </comment>

        <addColumn tableName="study_subject">
            <column name="patient_uuid" type="VARCHAR(36)"
                    remarks="Soft-link across studies — set when the nurse links a new enrollment to an existing patient match. Null when the subject is a new patient."/>
        </addColumn>

        <createIndex tableName="study_subject"
                     indexName="idx_study_subject_patient_uuid">
            <column name="patient_uuid"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="study_subject"
                       indexName="idx_study_subject_patient_uuid"/>
            <dropColumn tableName="study_subject" columnName="patient_uuid"/>
        </rollback>
    </changeSet>

    <changeSet id="2026-06-19-audit-type-study-subject-patient-linked"
               author="muw-ophthalmology"
               dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM audit_log_event_type
                WHERE audit_log_event_type_id = 119;
            </sqlCheck>
        </preConditions>
        <comment>
            Seed the cross-study patient-link audit type. Visible in
            per-study audit views (is_user_visible=true) so the operator
            timeline shows when a study_subject was tied to a patient
            already enrolled in another study.
        </comment>

        <insert tableName="audit_log_event_type">
            <column name="audit_log_event_type_id" valueNumeric="119"/>
            <column name="name" value="study_subject_patient_linked"/>
            <column name="display_name" value="Cross-study patient identity linked"/>
            <column name="is_user_visible" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="audit_log_event_type">
                <where>audit_log_event_type_id = 119</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
