<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
      The dataset wizard offers "CRF completion date" as an inclusion flag, and
      the extract writes the column when the flag is set (ExtractBean). But the
      dataset table never had a column for it: the flag was accepted, dropped
      on save, and read back as false, so no export ever carried the date.

      Appended last, so DatasetDAO reads it as column 37 of `select *`.
    -->
    <changeSet author="muw-ophthalmology" id="2026-11-24-dataset-show-crf-completion-date">
        <addColumn tableName="dataset">
            <column name="show_crf_completion_date" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="dataset" columnName="show_crf_completion_date"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
