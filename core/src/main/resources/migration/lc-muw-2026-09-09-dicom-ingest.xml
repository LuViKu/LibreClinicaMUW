<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        DR-025 — DICOM C-STORE receiver for handheld fundus cameras (HealthAEye).

        dicom_ingest — one row per fundus image received over DICOM C-STORE.

        The dicom-scp sidecar (pynetdicom Storage SCP, app host) writes the
        Part-10 object + a rendered preview to the ingest store, extracts the
        identity/exam tags, and POSTs them to the app's shared-secret internal
        ingest endpoint, which INSERTs a row here in status=UNBOUND.

        Binding is deliberately NULLABLE — images arrive unbound and an operator
        links each one to a subject/event/CRF in the SPA reconciliation inbox
        (Phase 1). A later slice adds PatientID/AccessionNumber auto-match on
        receipt (match_policy='auto'). Unlike the OCT path these are 2-D fundus
        photos: no GPU inference, just store + attach.

        No CHECK constraint on status/match_policy — the enum lives in Java, so
        adding a value is decoder-only (no schema migration), mirroring the
        retinal_inference_job 'task' discriminator.
    -->

    <changeSet author="muw-ophthalmology" id="2026-09-09-dicom-ingest">
        <createTable tableName="dicom_ingest">
            <column autoIncrement="true" name="dicom_ingest_id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <!-- DICOM identity / dedup — C-STORE may resend the same object. -->
            <column name="sop_instance_uid" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sop_class_uid" type="VARCHAR(128)"/>
            <column name="study_instance_uid" type="VARCHAR(128)"/>
            <column name="series_instance_uid" type="VARCHAR(128)"/>
            <column name="modality" type="VARCHAR(16)"/>
            <!-- Identity/exam tags used for matching (kept on-prem; no redaction). -->
            <column name="patient_id" type="VARCHAR(128)"/>
            <column name="patient_name" type="VARCHAR(255)"/>
            <column name="accession_number" type="VARCHAR(64)"/>
            <column name="study_date" type="DATE"/>
            <column name="laterality" type="VARCHAR(2)"/>
            <column name="source_ae_title" type="VARCHAR(32)"/>
            <!-- On-disk artifacts (paths, not blobs — mirrors the retinal store). -->
            <column name="dicom_path" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="preview_png_path" type="VARCHAR(500)"/>
            <column name="received_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <!-- Reconciliation state: UNBOUND / BOUND / DISMISSED. -->
            <column name="status" type="VARCHAR(16)" defaultValue="UNBOUND">
                <constraints nullable="false"/>
            </column>
            <column name="status_message" type="TEXT"/>
            <column name="match_policy" type="VARCHAR(16)"/>
            <!-- Nullable bindings — set at reconciliation / auto-match. -->
            <column name="bound_study_subject_id" type="INT"/>
            <column name="bound_study_event_id" type="INT"/>
            <column name="bound_event_crf_id" type="INT"/>
            <column name="bound_item_id" type="INT"/>
            <column name="bound_by_user_id" type="INT"/>
            <column name="bound_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="dicom_ingest" baseColumnNames="bound_study_subject_id"
                                 constraintName="fk_dicom_ingest_study_subject"
                                 referencedTableName="study_subject" referencedColumnNames="study_subject_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="dicom_ingest" baseColumnNames="bound_study_event_id"
                                 constraintName="fk_dicom_ingest_study_event"
                                 referencedTableName="study_event" referencedColumnNames="study_event_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="dicom_ingest" baseColumnNames="bound_event_crf_id"
                                 constraintName="fk_dicom_ingest_event_crf"
                                 referencedTableName="event_crf" referencedColumnNames="event_crf_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="dicom_ingest" baseColumnNames="bound_item_id"
                                 constraintName="fk_dicom_ingest_item"
                                 referencedTableName="item" referencedColumnNames="item_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="dicom_ingest" baseColumnNames="bound_by_user_id"
                                 constraintName="fk_dicom_ingest_user"
                                 referencedTableName="user_account" referencedColumnNames="user_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <createIndex tableName="dicom_ingest" indexName="idx_dicom_ingest_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="dicom_ingest" indexName="idx_dicom_ingest_patient_date">
            <column name="patient_id"/>
            <column name="study_date"/>
        </createIndex>

        <rollback>
            <dropTable tableName="dicom_ingest"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
