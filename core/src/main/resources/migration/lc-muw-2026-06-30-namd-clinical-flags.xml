<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!--
        2026-06-30 — nAMD two-arm RCT scope. Extends the F_NAMD_VISIT
        CRF (crf_id=3, crf_version_id=21) with:

          1. A new S_NAMD_CLINICAL_FLAGS section (id=12) carrying
             four per-eye booleans the rule engine consumes:
               * NAMD_OD_NEW_HEMORRHAGE, NAMD_OS_NEW_HEMORRHAGE
               * NAMD_OD_BCVA_LOSS_NAMD_ATTRIBUTED,
                 NAMD_OS_BCVA_LOSS_NAMD_ATTRIBUTED
          2. Eight new items on the existing S_NAMD_DECISION section
             (id=9) capturing the doctor's treatment decision +
             rationale code + free-text + clinical date + the AI
             recommendation snapshot at decision time:
               * NAMD_DECISION_ACTION (radio TREAT/OBSERVE)
               * NAMD_DECISION_DRUG (radio Bevacizumab/Aflibercept/
                 Faricimab; show-when ACTION=TREAT)
               * NAMD_DECISION_INTERVAL_WEEKS (int)
               * NAMD_DECISION_RATIONALE_CODE (single-select; one
                 union response set spans the study-arm-override
                 preset + the control-arm preset; SPA filters the
                 visible options by subject arm)
               * NAMD_DECISION_RATIONALE_OTHER (text; show-when
                 RATIONALE_CODE=OTHER)
               * NAMD_DECISION_DATE (DATE; optional clinical date
                 for retrospective backfill per
                 project_retrospective_data_phase memory)
               * NAMD_AI_REC_SNAPSHOT (text; JSON of
                 {rec, intervalWeeks, triggersFired[]})
               * NAMD_AI_AGREED (BL; computed SPA-side; true when
                 chosen action + interval match the AI rec)

        Plus one new audit_log_event_type id=124,
        treatment_decision_recorded — emitted by EventCrfsApiController
        when any of the seven decision items lands. See the plan
        at /Users/lukas/.claude/plans/robust-jumping-eich.md.

        ID allocation (continues prior runs):
          - section_id            = 12         (11 taken by AI section)
          - item_id               = 62..73     (61 taken by CRT items)
          - item_form_metadata_id = 39..50     (38 taken)
          - response_set_id       = 15..18     (14 taken)
          - audit_log_event_type_id = 124      (123 taken by retinal_segmentation_corrected)

        Context: "demo" matches the rest of the F_NAMD_VISIT seeding.
        Production institutional deployments opt in by re-running the
        same changesets under the production context — same convention
        as the existing NAMD seeds.
    -->

    <changeSet author="muw-ophthalmology" id="2026-06-30-namd-clinical-flags-section" context="demo">
        <comment>S_NAMD_CLINICAL_FLAGS section (id=12) for the per-eye observation booleans.</comment>
        <insert tableName="section">
            <column name="section_id" valueNumeric="12"/>
            <column name="crf_version_id" valueNumeric="21"/>
            <column name="status_id" valueNumeric="1"/>
            <column name="label" value="S_NAMD_CLINICAL_FLAGS"/>
            <column name="title" value="Clinical observation flags"/>
            <column name="instructions" value="Per-eye observation flags that feed the treat-and-extend rule engine. Record whether a new retinal hemorrhage was seen on the current OCT and whether any BCVA drop is clinically attributable to nAMD activity (vs cataract, dry eye, etc)."/>
            <column name="ordinal" valueNumeric="5"/>
            <column name="date_created" valueDate="2026-06-30"/>
            <column name="owner_id" valueNumeric="1"/>
        </insert>
        <rollback>
            <delete tableName="section">
                <where>section_id = 12</where>
            </delete>
        </rollback>
    </changeSet>

