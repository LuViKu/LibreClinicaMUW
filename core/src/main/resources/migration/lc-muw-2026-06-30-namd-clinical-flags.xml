    <!--
        Audit-event-type seed: TREATMENT_DECISION_RECORDED = 124.
        Emitted by EventCrfsApiController when any of the seven decision
        items lands. Mirrors the seed pattern of audit type 122 + 123.
    -->
    <changeSet author="muw-ophthalmology" id="2026-06-30-audit-event-type-treatment-decision" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM audit_log_event_type
                WHERE audit_log_event_type_id = 124;
            </sqlCheck>
        </preConditions>
        <insert tableName="audit_log_event_type">
            <column name="audit_log_event_type_id" valueNumeric="124"/>
            <column name="name" value="treatment_decision_recorded"/>
            <column name="display_name" value="Treatment decision recorded"/>
            <column name="is_user_visible" valueBoolean="true"/>
