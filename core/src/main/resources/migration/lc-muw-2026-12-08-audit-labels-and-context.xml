            </update>
            <update tableName="audit_log_event_type">
                <column name="display_name" value="Item data revalidated"/>
                <where>audit_log_event_type_id = 30</where>
            </update>
            <update tableName="audit_log_event_type">
                <column name="display_name" value="Subject signed (e-signature)"/>
                <where>audit_log_event_type_id = 31</where>
            </update>
            <update tableName="audit_log_event_type">
                <column name="display_name" value="SDV verified"/>
                <where>audit_log_event_type_id = 32</where>
            </update>
        </rollback>
    </changeSet>

    <!-- A dismissed file brought back into the inbox. Restores were written under 128, so a restore read as a dismissal. -->
    <changeSet id="2026-12-08-audit-type-ingest-restore" author="muw">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM audit_log_event_type WHERE audit_log_event_type_id = 137;
            </sqlCheck>
        </preConditions>
        <insert tableName="audit_log_event_type">
            <column name="audit_log_event_type_id" valueNumeric="137"/>
            <column name="name" value="ingest_restore"/>
            <column name="display_name" value="Ingested file restored"/>
            <column name="is_user_visible" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="audit_log_event_type">
                <where>audit_log_event_type_id = 137</where>
            </delete>
        </rollback>
    </changeSet>

